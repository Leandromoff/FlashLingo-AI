  },
  {
    "id": "leccion_9_gramatica_a1_s_es_card_70",
    "word": "¿Puedes darles mi número y decirles que me llamen?",
    "translation": "Você pode dar meu número a eles e pedir que me liguem?",
    "pronunciation": "/ˈpweðes ˈdaɾles mi ˈnumeɾo i deˈθiɾles ke me ˈʎamen/",
    "portuguesePhonetic": "[puédes dárles mi número i dethírles ke me lhámen]"
  },
  {
    "id": "leccion_9_gramatica_a1_s_es_card_71",
    "word": "Los conocimos en una fiesta y nos cayeron muy bien.",
