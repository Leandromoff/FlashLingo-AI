    "pronunciation": "/me resˈponde ˈrapiðo/",
    "portuguesePhonetic": "[me respónde rrápido]"
  },
  {
    "id": "leccion_9_gramatica_a1_s_es_card_28",
    "word": "Los vemos en la cafetería.",
