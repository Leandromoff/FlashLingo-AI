    "portuguesePhonetic": "[ábla kon élhos · son simpátikos]"
  },
  {
    "id": "leccion_9_gramatica_a1_s_es_card_43",
    "word": "Es un coche bonito.",
    "translation": "É um carro bonito.",
    "pronunciation": "/es un ˈkotʃe boˈnito/",
