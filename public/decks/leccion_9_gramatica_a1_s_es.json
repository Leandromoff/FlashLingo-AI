  },
  {
    "id": "leccion_9_gramatica_a1_s_es_card_21",
    "word": "Me llama todos los días.",
    "translation": "Ele me liga todo dia.",
    "pronunciation": "/me ˈʎama ˈtoðos los ˈdias/",
    "portuguesePhonetic": "[me lháma tódos los días]"
  },
  {
    "id": "leccion_9_gramatica_a1_s_es_card_22",
    "word": "Te quiero mucho.",
    "translation": "Eu gosto muito de você.",
    "pronunciation": "/te ˈkjeɾo ˈmutʃo/",
    "portuguesePhonetic": "[te kiéro mútcho]"
  },
  {
    "id": "leccion_9_gramatica_a1_s_es_card_23",
    "word": "Dáselo después de clase.",
    "translation": "Dê isso a ele depois da aula.",
    "pronunciation": "/ˈdaselo desˈpwes de ˈklase/",
