    "pronunciation": "/ˈteŋɡo ˈklases los ˈmaɾtes i ˈxweβes/",
    "portuguesePhonetic": "[téngo kláses los mártes i rruébes]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_49",
    "word": "La tienda cierra los domingos.",
    "translation": "A loja fecha aos domingos.",
    "pronunciation": "/la ˈtjenda ˈθjera los doˈmiŋɡos/",
    "portuguesePhonetic": "[la tiénda thiérra los domíngos]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_50",
    "word": "El verano es mi estación favorita.",
    "translation": "O verão é minha estação favorita.",
    "pronunciation": "/el beˈɾano es mi estaˈθjon faβoˈɾita/",
    "portuguesePhonetic": "[el beráno és mi estathión faboríta]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_51",
    "word": "Hoy es lunes.",
    "translation": "Hoje é segunda.",
    "pronunciation": "/oi es ˈlunes/",
    "portuguesePhonetic": "[ôi és lúnes]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_52",
    "word": "Me gusta el verano.",
    "translation": "Eu gosto do verão.",
    "pronunciation": "/me ˈɡusta el beˈɾano/",
    "portuguesePhonetic": "[me gústa el beráno]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_53",
    "word": "Mi cumpleaños es en abril.",
    "translation": "Meu aniversário é em abril.",
    "pronunciation": "/mi kumpleˈaɲos es en aˈβɾil/",
    "portuguesePhonetic": "[mi kumpleánhos és en abríl]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_54",
    "word": "Descansamos los fines de semana.",
    "translation": "Nós descansamos nos fins de semana.",
    "pronunciation": "/deskanˈsamos los ˈfines de seˈmana/",
    "portuguesePhonetic": "[deskansámos los fínes de semána]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_55",
    "word": "El fin de semana empieza el sábado.",
    "translation": "O fim de semana começa no sábado.",
    "pronunciation": "/el fin de seˈmana emˈpjeθa el ˈsaβaðo/",
    "portuguesePhonetic": "[el fín de semána empiétha el sábado]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_56",
    "word": "El invierno es más frío que el otoño.",
    "translation": "O inverno é mais frio que o outono.",
    "pronunciation": "/el imˈbjeɾno es mas ˈfɾio ke el oˈtoɲo/",
    "portuguesePhonetic": "[el imbiérno és mas frío ke el otónho]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_57",
    "word": "¿Qué día es hoy?",
    "translation": "Que dia é hoje?",
    "pronunciation": "/ke ˈdia es oi/",
    "portuguesePhonetic": "[ke día és ôi]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_58",
    "word": "No trabajo los viernes.",
    "translation": "Eu não trabalho às sextas.",
    "pronunciation": "/no tɾaˈβaxo los ˈbjeɾnes/",
    "portuguesePhonetic": "[no trabárro los biérnes]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_59",
    "word": "¿Cuándo es tu cumpleaños?",
    "translation": "Quando é seu aniversário?",
    "pronunciation": "/ˈkwando es tu kumpleˈaɲos/",
    "portuguesePhonetic": "[kuándo és tu kumpleánhos]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_60",
    "word": "¿El curso empieza en septiembre?",
    "translation": "O curso começa em setembro?",
    "pronunciation": "/el ˈkuɾso emˈpjeθa en sepˈtjembɾe/",
    "portuguesePhonetic": "[el kúrso empiétha en septiémbre]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_61",
    "word": "Todavía no es verano.",
    "translation": "Ainda não é verão.",
    "pronunciation": "/toðaˈβia no es beˈɾano/",
    "portuguesePhonetic": "[todabía no és beráno]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_62",
    "word": "¿Por qué te gusta la primavera?",
    "translation": "Por que você gosta da primavera?",
    "pronunciation": "/poɾ ke te ˈɡusta la pɾimaˈβeɾa/",
    "portuguesePhonetic": "[por ké te gústa la primabéra]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_63",
    "word": "Me encanta el verano porque hace calor.",
    "translation": "Eu amo o verão porque é quente.",
    "pronunciation": "/me eŋˈkanta el beˈɾano ˈpoɾke ˈaθe kaˈloɾ/",
    "portuguesePhonetic": "[me enkánta el beráno pórke áthe kalór]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_64",
    "word": "Vamos a viajar en agosto.",
    "translation": "Nós vamos viajar em agosto.",
    "pronunciation": "/ˈbamos a bjaˈxaɾ en aˈɣosto/",
    "portuguesePhonetic": "[bámos a biarrár en agósto]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_65",
    "word": "Nevó el invierno pasado.",
    "translation": "Nevou no inverno passado.",
    "pronunciation": "/neˈβo el imˈbjeɾno paˈsaðo/",
    "portuguesePhonetic": "[nebó el imbiérno pasádo]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_66",
    "word": "Nací en octubre.",
    "translation": "Eu nasci em outubro.",
    "pronunciation": "/naˈθi en okˈtuβɾe/",
    "portuguesePhonetic": "[nathí en oktúbre]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_67",
    "word": "Cuando llega la primavera, los días se hacen más largos.",
    "translation": "Quando a primavera chega, os dias ficam mais longos.",
    "pronunciation": "/ˈkwando ˈʎeɣa la pɾimaˈβeɾa los ˈdias se ˈaθen mas ˈlaɾɣos/",
    "portuguesePhonetic": "[kuándo lhéga la primabéra los días se áthen mas lárgos]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_68",
    "word": "Mi mes favorito es diciembre por la Navidad.",
    "translation": "Meu mês favorito é dezembro por causa do Natal.",
    "pronunciation": "/mi mes faβoˈɾito es diˈθjembɾe poɾ la naβiˈðað/",
    "portuguesePhonetic": "[mi més faboríto és dithiémbre por la nabidád]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_69",
    "word": "Normalmente vamos de vacaciones en julio, pero este año iremos en agosto.",
    "translation": "Geralmente viajamos em julho, mas este ano vamos em agosto.",
    "pronunciation": "/noɾˈmalmente ˈbamos de bakaˈθjones en ˈxuljo ˈpeɾo ˈeste ˈaɲo iˈɾemos en aˈɣosto/",
    "portuguesePhonetic": "[normalménte bámos de bakathiónes en rrúlio péro éste ánho irémos en agósto]"
  },
  {
    "id": "leccion_6_vocabulario_a1_s_es_card_70",
