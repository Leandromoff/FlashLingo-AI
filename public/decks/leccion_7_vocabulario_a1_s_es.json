    "pronunciation": "/ˈkwantos ˈweβos ˈkjeɾes/",
    "portuguesePhonetic": "[kuántos uébos kiéres]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_61",
    "word": "No me gusta mucho el jamón.",
