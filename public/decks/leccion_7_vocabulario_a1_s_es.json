    "portuguesePhonetic": "[élha kóme frúta]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_53",
    "word": "Bebemos café.",
    "translation": "Nós tomamos café.",
    "pronunciation": "/beˈβemos kaˈfe/",
    "portuguesePhonetic": "[bebémos kafé]"
