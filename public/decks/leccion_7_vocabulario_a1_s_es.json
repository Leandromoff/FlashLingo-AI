    "pronunciation": "/la ˈfɾuta esˈta mui ˈdulθe/",
    "portuguesePhonetic": "[la frúta está múi dúlthe]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_51",
    "word": "Me gusta el queso.",
    "translation": "Eu gosto de queijo.",
    "pronunciation": "/me ˈɡusta el ˈkeso/",
    "portuguesePhonetic": "[me gústa el késo]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_52",
