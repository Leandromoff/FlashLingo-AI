  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_62",
    "word": "¿Queda algo de tarta?",
    "translation": "Sobrou bolo?",
    "pronunciation": "/ˈkeða ˈalɣo de ˈtaɾta/",
    "portuguesePhonetic": "[kéda álgo de tárta]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_63",
    "word": "Como tostadas porque me encanta la mantequilla.",
    "translation": "Eu como torrada porque adoro manteiga.",
    "pronunciation": "/ˈkomo tosˈtaðas ˈpoɾke me eŋˈkanta la manteˈkiʎa/",
    "portuguesePhonetic": "[kómo tostádas pórke me enkánta la mantekílha]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_64",
    "word": "Está haciendo un bocadillo ahora.",
