    "pronunciation": "/ˈeʎa no ˈkome pan/",
    "portuguesePhonetic": "[élha no kóme pan]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_57",
    "word": "¿Te gusta el yogur?",
    "translation": "Você gosta de iogurte?",
    "pronunciation": "/te ˈɡusta el ʝoˈɣuɾ/",
    "portuguesePhonetic": "[te gústa el iogúr]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_58",
    "word": "No hay mantequilla.",
    "translation": "Não tem manteiga.",
    "pronunciation": "/no ai manteˈkiʎa/",
    "portuguesePhonetic": "[no ái mantekílha]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_59",
    "word": "¿Qué comes a mediodía?",
