    "pronunciation": "/ˈesta ˈtaɾta esˈta deliˈθjosa/",
    "portuguesePhonetic": "[ésta tárta está delithiósa]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_49",
    "word": "Toma una galleta.",
