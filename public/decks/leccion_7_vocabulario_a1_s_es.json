    "portuguesePhonetic": "[no kóme tchokolatínas pórke son demasiádo dúlthes]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_70",
    "word": "Si tienes hambre, come fruta o un yogur.",
    "translation": "Se você está com fome, coma uma fruta ou um iogurte.",
    "pronunciation": "/si ˈtjenes ˈambɾe ˈkome ˈfɾuta o un ʝoˈɣuɾ/",
    "portuguesePhonetic": "[si tiénes âmbre kóme frúta o un iogúr]"
