    "pronunciation": "/aˈʝeɾ koˈmimos ˈtaɾta en la ˈfjesta/",
    "portuguesePhonetic": "[aiér komímos tárta en la fiésta]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_66",
    "word": "Estaba comiendo cereales cuando llamaste.",
    "translation": "Eu estava comendo cereal quando você ligou.",
    "pronunciation": "/esˈtaβa koˈmjendo θeɾeˈales ˈkwando ʎaˈmaste/",
    "portuguesePhonetic": "[estába komiéndo thereáles kuándo lhamáste]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_67",
    "word": "Compró pan, queso y jamón.",
    "translation": "Ele comprou pão, queijo e presunto.",
    "pronunciation": "/komˈpɾo pan ˈkeso i xaˈmon/",
    "portuguesePhonetic": "[kompró pan késo i rramón]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_68",
    "word": "Siempre desayuno mucho, pero ceno poco.",
    "translation": "Eu sempre tomo um café da manhã reforçado, mas janto pouco.",
    "pronunciation": "/ˈsjempɾe desaˈʝuno ˈmutʃo ˈpeɾo ˈθeno ˈpoko/",
    "portuguesePhonetic": "[siémpre desaiúno mútcho péro théno póko]"
  },
  {
    "id": "leccion_7_vocabulario_a1_s_es_card_69",
    "word": "No come chocolatinas porque son demasiado dulces.",
